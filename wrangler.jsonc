{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devs-web-id",
  "compatibility_date": "2026-11-10",
  // Static only. Kalau nanti butuh /api: tambah "main", assets.binding "ASSETS",
  // dan assets.run_worker_first ["/api/*"] (lihat AGENTS.md §6).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
