---
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import { tools } from '../config/site';

interface Props {
  slug: string;
  title: string;
  description: string;
  /** Judul H1, kalau beda dari nama tool. */
  heading?: string;
  lead: string;
}

const { slug, title, description, heading, lead } = Astro.props;
const tool = tools.find((t) => t.slug === slug);
const others = tools.filter((t) => t.slug !== slug).slice(0, 4);
const h1 = heading ?? tool?.name ?? '';
---

<Base title={title} description={description}>
  <PageHeader crumb={tool?.name ?? h1} heading={h1} lead={lead}>
    {
      tool && (
        <Fragment slot="meta">
          <Icon name={tool.icon} class="size-7" />
          <span class:list={['badge', tool.runs !== 'api' && 'badge-ghost']}>{tool.runs === 'api' ? 'JSON API statis' : 'Diproses di browser'}</span>
          {tool.tags.map((t) => <span class="chip max-sm:hidden">{t}</span>)}
        </Fragment>
      )
    }
  </PageHeader>

  <div class="wrap mt-12 grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
    <div class="min-w-0">
      <slot />
    </div>
    <aside class="min-w-0 space-y-10 text-sm lg:border-l lg:border-line-2 lg:pl-8">
      <slot name="aside" />
      <section>
        <h2 class="t-h3">Tools lain</h2>
        <ul class="mt-3 space-y-1">
          {
            others.map((t) => (
              <li>
                <a class="-mx-2 flex items-center gap-2.5 rounded-[var(--r-sm)] px-2 py-1.5 text-ink-2 hover:bg-wash hover:text-ink" href={`/${t.slug}/`}>
                  <Icon name={t.icon} class="size-4 text-mute" />
                  {t.name}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>
</Base>
