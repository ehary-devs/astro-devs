---
import Tool from '../../layouts/Tool.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import Icon from '../../components/Icon.astro';
import { KAB, PROV, meta } from '../../lib/jadwal-data';

const usage = `const res = await fetch('https://devs.web.id/api/jadwal-sholat/${meta.tahun[0]}/33.74.json');
const { nama, waktu, jadwal } = await res.json();
// waktu:  ["imsak","subuh","terbit","dhuha","dzuhur","ashar","maghrib","isya"]
// jadwal: { "${meta.tahun[0]}-01-01": ["03:53","04:03", ...], ... } jam waktu setempat`;
// [kode, label, slug]; label memuat provinsi, kode tampil di kanan seperti tool wilayah.
const items = JSON.stringify(KAB.map((k) => [k.kode, `${k.nama} · ${k.provNama}`, k.slug]));
const populer = ['31.71', '32.73', '33.74', '34.71', '35.78', '12.71', '73.71', '51.71'].map((kode) => KAB.find((k) => k.kode === kode)!);
---

<Tool
  slug="jadwal-sholat"
  title="Jadwal Sholat Hari Ini di 514 Kabupaten/Kota"
  description="Jadwal imsak, subuh, dzuhur, ashar, maghrib, dan isya untuk 514 kabupaten/kota dari SIHAT Kemenag RI, lengkap dengan JSON statis gratis tanpa API key."
  lead="Jadwal resmi Kementerian Agama RI (SIHAT) untuk 514 kabupaten/kota. Cari wilayahmu untuk melihat sholat berikutnya, jadwal hari ini, dan sebulan penuh."
>
  <div class="panel">
    <form id="js-form" novalidate>
      <label class="label" for="js-kab">Kabupaten/kota</label>
      <div class="field-wrap">
        <Icon name="search" class="field-icon size-[1.125rem]" />
        <input
          id="js-kab"
          class="field font-sans pr-10"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="js-kab-list"
          autocomplete="off"
          spellcheck="false"
          placeholder="Ketik nama kota atau kabupaten..."
          data-items={items}
        />
        <Icon name="selector" class="field-icon-r size-[1.125rem]" />
        <ul id="js-kab-list" class="cb-list" role="listbox" aria-label="Kabupaten/kota" hidden></ul>
      </div>
    </form>
    <div class="mt-5 flex flex-wrap gap-2">
      {populer.map((k) => <a class="chip hover:border-ink hover:text-ink" href={`/jadwal-sholat/${k.slug}/`}>{k.nama.replace(/^Kota (Administrasi )?/, '')}</a>)}
    </div>
  </div>

  <section class="mt-16">
    <h2 class="t-h2">Semua kabupaten/kota</h2>
    <div class="mt-6 divide-y divide-line border-y border-line">
      {
        PROV.map((p) => (
          <details class="group">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3.5 hover:text-ink">
              <span class="font-medium">{p.nama}</span>
              <span class="flex items-center gap-3 text-mute">
                <span class="mono text-[0.8125rem]">{p.kab.length}</span>
                <Icon name="chevron-down" class="size-4 transition-transform group-open:rotate-180" />
              </span>
            </summary>
            <ul class="grid gap-x-6 gap-y-1.5 pb-5 sm:grid-cols-2 lg:grid-cols-3">
              {p.kab.map((k) => <li><a class="text-ink-2 hover:text-ink hover:underline" href={`/jadwal-sholat/${k.slug}/`}>{k.nama}</a></li>)}
            </ul>
          </details>
        ))
      }
    </div>
  </section>

  <section class="mt-16 space-y-5">
    <h2 class="t-h2">Endpoint</h2>
    <div class="overflow-x-auto">
      <table class="table min-w-[34rem]">
        <thead><tr><th>Path</th><th>Isi</th></tr></thead>
        <tbody>
          <tr><td class="mono">/api/jadwal-sholat/{'{tahun}'}/{'{kab}'}.json</td><td>Jadwal setahun satu kab/kota, contoh /{meta.tahun[0]}/33.74.json</td></tr>
          <tr><td class="mono">/api/jadwal-sholat/meta.json</td><td>Tahun tersedia, sumber, tanggal ambil</td></tr>
        </tbody>
      </table>
    </div>
    <p class="text-ink-2 max-w-xl">
      Kode kab/kota sama dengan <a class="link" href="/wilayah/">API kode wilayah</a>. Jam dalam waktu setempat (WIB/WITA/WIT). <code>lat</code>/<code>lng</code> adalah titik acuan hisab Kemenag. Beberapa kabupaten punya <code>titik</code> tambahan untuk pulau yang jauh dari ibu kotanya.
    </p>
    <CodeBlock label="JavaScript" code={usage} />
  </section>

  <Fragment slot="aside">
    <section>
      <h2 class="t-h3">Sumber</h2>
      <p class="mt-3 text-ink-2">
        <a class="link" href="https://bimasislam.kemenag.go.id/jadwal-sholat" target="_blank" rel="noopener noreferrer">Sistem Informasi Hisab Rukyat (SIHAT) Kemenag RI</a>, diambil {meta.diambil}. Lima kota administrasi Jakarta memakai satu titik yang sama, karena Kemenag hanya menerbitkan satu jadwal untuk DKI Jakarta.
      </p>
    </section>
    <section>
      <h2 class="t-h3">Cakupan</h2>
      <dl class="mt-3 grid grid-cols-[1fr_auto] gap-y-1 text-ink-2">
        <dt>Kabupaten/kota</dt><dd class="mono">{meta.kabkota}</dd>
        <dt>Titik tambahan</dt><dd class="mono">{meta.titik_tambahan}</dd>
        <dt>Tahun</dt><dd class="mono">{meta.tahun.join(', ')}</dd>
      </dl>
    </section>
  </Fragment>
</Tool>

<script>
  import { combobox } from '../../lib/combobox';

  const input = document.querySelector<HTMLInputElement>('#js-kab')!;
  const items: [kode: string, label: string, slug: string][] = JSON.parse(input.dataset.items!);
  const slug = new Map(items.map(([kode, , s]) => [kode, s]));
  const box = combobox(input, document.querySelector<HTMLUListElement>('#js-kab-list')!, (it) => {
    location.href = `/jadwal-sholat/${slug.get(it.value)}/`;
  });
  box.set(items.map(([value, label]) => ({ value, label })), `Cari dari ${items.length} kabupaten/kota`);
</script>
