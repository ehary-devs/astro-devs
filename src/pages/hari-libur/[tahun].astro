---
import type { GetStaticPaths } from 'astro';
import Tool from '../../layouts/Tool.astro';
import LiburTable from '../../components/LiburTable.astro';
import { LIBUR, type TahunLibur } from '../../data/libur';

export const getStaticPaths = (() => LIBUR.map((t) => ({ params: { tahun: String(t.tahun) }, props: { t } }))) satisfies GetStaticPaths;

const { t } = Astro.props as { t: TahunLibur };
const libur = t.data.filter((d) => d.jenis === 'libur').length;
const cuti = t.data.filter((d) => d.jenis === 'cuti').length;
const others = LIBUR.filter((x) => x.tahun !== t.tahun);
---

<Tool
  slug="hari-libur"
  title={`Hari libur nasional dan cuti bersama ${t.tahun}`}
  heading={`Hari libur nasional dan cuti bersama ${t.tahun}`}
  description={`Daftar ${libur} hari libur nasional dan ${cuti} hari cuti bersama ${t.tahun} sesuai SKB 3 Menteri, lengkap dengan hari, JSON API, dan kalender .ics.`}
  lead={`${libur} hari libur nasional dan ${cuti} hari cuti bersama, disalin dari SKB 3 Menteri tentang hari libur ${t.tahun}.`}
>
  <div class="flex flex-wrap gap-3">
    <a class="btn" href={`/kalender/libur-${t.tahun}.ics`}>Unduh kalender {t.tahun}</a>
    <a class="btn btn-ghost" href={`/api/libur/${t.tahun}.json`}>JSON {t.tahun}</a>
  </div>
  <p id="next" class="mt-6 text-ink-2" hidden></p>

  <div class="mt-10"><LiburTable t={t} /></div>

  <Fragment slot="aside">
    <section>
      <h2 class="t-h3">Tahun lain</h2>
      <ul class="mt-3 space-y-2">
        {others.map((x) => <li><a class="link" href={`/hari-libur/${x.tahun}/`}>Libur {x.tahun}</a></li>)}
        <li><a class="link" href="/hari-libur/">Semua tahun dan API</a></li>
      </ul>
    </section>
  </Fragment>
</Tool>

<script>
  import '../../scripts/libur-next';
</script>
