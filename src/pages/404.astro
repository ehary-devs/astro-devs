---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { tools } from '../config/site';
---

<Base title="Halaman tidak ditemukan" description="Halaman yang kamu cari tidak ada." noindex>
  <div class="gridbg border-b border-line-2">
    <div class="wrap py-16 sm:py-24">
      <p class="badge">Error 404</p>
      <h1 class="t-display mt-6">Halaman ini <span class="serif">tidak ada.</span></h1>
      <p class="t-lead mt-5">Mungkin alamatnya salah ketik, atau halamannya sudah dipindah.</p>
      <a class="btn mt-8" href="/"><Icon name="arrow-left" class="size-4" />Kembali ke beranda</a>
    </div>
  </div>
  <div class="wrap mt-14">
    <p class="t-eyebrow">Tools yang tersedia</p>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        tools.map((t) => (
          <li>
            <a class="card group flex items-center gap-3 p-4" href={`/${t.slug}/`}>
              <span class="tile"><Icon name={t.icon} /></span>
              <span class="font-medium">{t.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
