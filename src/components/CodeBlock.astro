---
import Icon from './Icon.astro';

interface Props {
  code: string;
  /** Nama bahasa/berkas yang tampil di atas blok. */
  label?: string;
}
const { code, label } = Astro.props;
---

<figure class="min-w-0" data-codeblock>
  <figcaption class="flex items-center justify-between gap-3 border border-b-0 border-ink bg-[#18181b] px-3 py-1.5">
    <span class="mono text-[0.6875rem] uppercase tracking-[0.06em] text-[#8b8b92]">{label}</span>
    <button type="button" class="btn btn-sm !border-[#3a3a3f] !bg-transparent !text-[#e8e8e4] hover:!bg-[#2a2a2e]" data-copy><Icon name="copy" class="size-3.5" /><span data-label>Salin</span></button>
  </figcaption>
  <pre class="code border-t-[#2a2a2e]"><code>{code.trim()}</code></pre>
</figure>

<script>
  import { bindCopy } from '../lib/dom';
  for (const fig of document.querySelectorAll<HTMLElement>('[data-codeblock]')) {
    const btn = fig.querySelector<HTMLButtonElement>('[data-copy]')!;
    bindCopy(btn, () => fig.querySelector('code')?.textContent ?? '');
  }
</script>
