---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';

const path = Astro.url.pathname;
const active = (href: string) => !href.startsWith('/#') && path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line-2 bg-paper/95 backdrop-blur">
  <div class="wrap h-[var(--header-h)] flex items-center justify-between gap-3">
    <a href="/" class="shrink-0" aria-label={`${site.name}, beranda`}><Logo /></a>
    <nav aria-label="Navigasi utama">
      <ul class="flex items-center gap-0.5 sm:gap-1 text-sm">
        {
          site.nav.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={active(l.href) ? 'page' : undefined}
                class:list={[
                  'inline-flex items-center gap-1.5 whitespace-nowrap rounded-[var(--r-sm)] px-1.5 py-1.5 sm:px-2.5 transition-colors hover:bg-wash hover:text-ink',
                  active(l.href) ? 'bg-wash text-ink font-medium' : 'text-ink-2',
                ]}
              >
                {l.icon && <Icon name={l.icon} class="hidden size-4 sm:block" />}
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
